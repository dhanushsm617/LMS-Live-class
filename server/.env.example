# ───────── Core ─────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/lms
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=your_secret_key
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# ───────── Video storage / delivery ─────────
# local = files on disk, served by Express (development)
# s3    = files in S3, delivered through CloudFront with signed cookies (production)
STORAGE_DRIVER=local
STORAGE_ROOT=storage
TMP_DIR=tmp
KEEP_RAW_UPLOADS=false
MAX_VIDEO_MB=2048

# Only needed when STORAGE_DRIVER=s3
AWS_REGION=ap-south-1
S3_BUCKET=
# AWS credentials come from the default provider chain (env vars, IAM role, ~/.aws)
CLOUDFRONT_DOMAIN=            # e.g. d1234abcd.cloudfront.net  or  cdn.example.com
CLOUDFRONT_KEY_PAIR_ID=       # public key ID from a CloudFront key group
CLOUDFRONT_PRIVATE_KEY=       # PEM contents, newlines written as \n
CLOUDFRONT_COOKIE_DOMAIN=     # parent domain of both API and CDN, e.g. .example.com
CLOUDFRONT_COOKIE_TTL_SEC=14400

# ───────── FFmpeg worker ─────────
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
VIDEO_WORKER_CONCURRENCY=1

# ───────── Payments ─────────
# Leave STRIPE_SECRET_KEY empty to use the built-in mock checkout.
# With a Stripe *test* key (sk_test_...) real Stripe Checkout is used.
PAYMENT_MODE=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CURRENCY=inr
PLATFORM_FEE_PERCENT=20

# ───────── Live classes (LiveKit = open-source WebRTC SFU) ─────────
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
